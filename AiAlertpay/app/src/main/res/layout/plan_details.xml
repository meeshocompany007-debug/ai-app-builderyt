        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="18dp" android:text="Soundbox plan" android:textStyle="bold" android:textColor="#20171B" android:textSize="28sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/team_panel">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="One-day trial" android:textSize="17sp" android:textColor="#24191D"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹2" android:textSize="18sp" android:textStyle="bold" android:textColor="#24191D"/>
            </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DED6D4"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Monthly renewal" android:textSize="17sp" android:textColor="#24191D"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹99 / month" android:textSize="18sp" android:textStyle="bold" android:textColor="#24191D"/>
            </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="AutoPay setup" android:textStyle="bold" android:textColor="#70001C" android:textSize="20sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Merchant setup is pending. This app cannot start a trial or collect a subscription payment yet." android:textColor="#33272A" android:textSize="16sp"/>
        </LinearLayout>
    </ScrollView>
