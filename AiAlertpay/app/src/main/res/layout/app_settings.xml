<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:orientation="vertical" android:background="#FFF9F1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:gravity="center_vertical" android:background="#70001C">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp" android:text="AiAlertpay  |  Settings" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="22sp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingBottom="20dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:text="Voice alerts" android:textSize="20sp" android:textStyle="bold" android:textColor="#70001C"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/team_panel"><Switch android:id="@+id/voice_on" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingHorizontal="16dp" android:text="Payment voice alerts" android:textSize="16sp"/><Button android:id="@+id/settings_language" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingHorizontal="16dp" android:gravity="start|center_vertical" android:text="Speaker language" android:textColor="#281E22" android:textAllCaps="false" android:textSize="16sp" android:background="?android:attr/selectableItemBackground"/><Button android:id="@+id/settings_closing" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingHorizontal="16dp" android:gravity="start|center_vertical" android:text="Closing message" android:textColor="#281E22" android:textAllCaps="false" android:textSize="16sp" android:background="?android:attr/selectableItemBackground"/><Button android:id="@+id/settings_test" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingHorizontal="16dp" android:gravity="start|center_vertical" android:text="Test voice" android:textColor="#281E22" android:textAllCaps="false" android:textSize="16sp" android:background="?android:attr/selectableItemBackground"/></LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:text="Alert setup" android:textSize="20sp" android:textStyle="bold" android:textColor="#70001C"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/team_panel"><Button android:id="@+id/settings_apps" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingHorizontal="16dp" android:gravity="start|center_vertical" android:text="Payment apps" android:textColor="#281E22" android:textAllCaps="false" android:textSize="16sp" android:background="?android:attr/selectableItemBackground"/><Button android:id="@+id/settings_permissions" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingHorizontal="16dp" android:gravity="start|center_vertical" android:text="Permissions and volume" android:textColor="#281E22" android:textAllCaps="false" android:textSize="16sp" android:background="?android:attr/selectableItemBackground"/></LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:text="Payment QR" android:textSize="20sp" android:textStyle="bold" android:textColor="#70001C"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/team_panel"><Button android:id="@+id/settings_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingHorizontal="16dp" android:gravity="start|center_vertical" android:text="UPI address" android:textColor="#281E22" android:textAllCaps="false" android:textSize="16sp" android:background="?android:attr/selectableItemBackground"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:text="Billing" android:textSize="20sp" android:textStyle="bold" android:textColor="#70001C"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/team_panel">
                <Button android:id="@+id/settings_subscription" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingHorizontal="16dp" android:gravity="start|center_vertical" android:text="Subscription" android:textColor="#281E22" android:textAllCaps="false" android:textSize="16sp" android:background="?android:attr/selectableItemBackground"/></LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:minWidth="0dp" android:paddingHorizontal="1dp" android:gravity="center" android:textAllCaps="false" android:textSize="14sp" android:id="@+id/open_collection" android:text="Collection" android:textColor="#70001C" android:background="#FFFFFF"/><Button android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:minWidth="0dp" android:paddingHorizontal="1dp" android:gravity="center" android:textAllCaps="false" android:textSize="14sp" android:id="@+id/open_qr" android:text="QR" android:textColor="#70001C" android:background="#FFFFFF"/><Button android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:minWidth="0dp" android:paddingHorizontal="1dp" android:gravity="center" android:textAllCaps="false" android:textSize="14sp" android:id="@+id/open_team" android:text="Team" android:textColor="#70001C" android:background="#FFFFFF"/><TextView android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:minWidth="0dp" android:paddingHorizontal="1dp" android:gravity="center" android:textAllCaps="false" android:textSize="14sp" android:text="Settings" android:textColor="#FFFFFF" android:background="#70001C"/></LinearLayout>
</LinearLayout>